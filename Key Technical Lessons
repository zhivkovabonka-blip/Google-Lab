#!/bin/bash

# --- 1. Environment Setup ---
PROJECT_ID=$(gcloud config get-value project)
ZONE=$(gcloud compute zones list --filter="name~us-central1" --limit=1 --format="value(name)")

echo "Starting deployment for Project: $PROJECT_ID"

# --- 2. Create VM Instances ---
echo "Creating VM instances..."
gcloud compute instances create spoke1-vm \
    --zone=$ZONE --machine-type=e2-micro \
    --network=spoke1-vpc --subnet=spoke1-subnet \
    --image-family=debian-11 --image-project=debian-cloud \
    --metadata=enable-oslogin=true --quiet

gcloud compute instances create spoke2-vm \
    --zone=$ZONE --machine-type=e2-micro \
    --network=spoke2-vpc --subnet=spoke2-subnet \
    --image-family=debian-11 --image-project=debian-cloud \
    --metadata=enable-oslogin=true --quiet

# --- 3. NCC Configuration (The Hub) ---
echo "Creating NCC Hub: my-hub..."
gcloud network-connectivity hubs create my-hub \
    --preset-topology=MESH \
    --description="Mesh topology hub"

# --- 4. Create Spokes (The "Verified" Syntax) ---
echo "Attaching VPC Spokes..."
gcloud network-connectivity spokes linked-vpc-network create spoke1 \
    --hub=my-hub \
    --vpc-network=spoke1-vpc \
    --global \
    --description="Spoke for VPC 1"

gcloud network-connectivity spokes linked-vpc-network create spoke2 \
    --hub=my-hub \
    --vpc-network=spoke2-vpc \
    --global \
    --description="Spoke for VPC 2"

# --- 5. Final Status ---
echo "Deployment complete. Verification:"
gcloud network-connectivity spokes list --global
