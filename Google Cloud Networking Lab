# 1. Create the custom VPC network
gcloud compute networks create privatenet --subnet-mode=custom

# 2. Create the custom subnet
gcloud compute networks subnets create privatenet-us \
    --network=privatenet \
    --region=us-east4 \
    --range=10.130.0.0/20

# 3. Create the firewall rule for SSH via IAP
gcloud compute firewall-rules create privatenet-allow-ssh \
    --network=privatenet \
    --allow=tcp:22 \
    --source-ranges=35.235.240.0/20 \
    --target-tags=allow-ssh

# 4. Create the internal VM instance without a public IP
gcloud compute instances create vm-internal \
    --zone=us-east4-c \
    --machine-type=e2-medium \
    --subnet=privatenet-us \
    --no-address \
    --image-family=debian-12 \
    --image-project=debian-cloud \
    --tags=allow-ssh

# 5. Enable Private Google Access on the subnet
gcloud compute networks subnets update privatenet-us \
    --region=us-east4 \
    --enable-private-ip-google-access

# 6. Configure Cloud Router and Cloud NAT for internet access
gcloud compute routers create nat-router \
    --network=privatenet \
    --region=us-east4

gcloud compute routers nats create nat-config \
    --router=nat-router \
    --region=us-east4 \
    --auto-allocate-nat-external-ips \
    --nat-all-subnet-ip-ranges
