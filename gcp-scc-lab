#!/usr/bin/env bash
# Task 1 – Initiate and Mitigate a Threat with Event Threat Detection
set -euo pipefail

PROJECT_ID="qwiklabs-gcp-04-2f118a0a99ce"
DEMO_USER="demouser1@gmail.com"
ROLE="roles/bigquery.admin"

echo "=== [1] Set project ==="
