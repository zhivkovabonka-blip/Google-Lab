# setup.sh

#!/bin/bash
set -e

# ==============================
# Project configuration
# ==============================

export PROJECT_ID="qwiklabs-gcp-01-93900b9154b3"
export CLUSTER_NAME="central"
export CLUSTER_ZONE="us-east4-b"
export PROJECT_NUMBER=$(gcloud projects describe "$PROJECT_ID" \
  --format="value(projectNumber)")
export WORKLOAD_POOL="${PROJECT_ID}.svc.id.goog"
export MESH_ID="proj-${PROJECT_NUMBER}"

gcloud config set project "$PROJECT_ID"
gcloud config set compute/zone "$CLUSTER_ZONE"

# ==============================
# Create GKE cluster
# ==============================

gcloud container clusters create "$CLUSTER_NAME" \
  --machine-type=e2-standard-4 \
  --num-nodes=4 \
  --subnetwork=default \
  --release-channel=regular \
  --labels="mesh_id=${MESH_ID}" \
  --workload-pool="${WORKLOAD_POOL}" \
  --logging=SYSTEM,WORKLOAD

# ==============================
# Configure cluster
# ==============================

gcloud container fleet mesh enable

gcloud container clusters get-credentials "$CLUSTER_NAME" \
  --zone "$CLUSTER_ZONE" \
  --project "$PROJECT_ID"

kubectl create clusterrolebinding cluster-admin-binding \
  --clusterrole=cluster-admin \
  --user="$(gcloud config get-value account)" || true

kubectl create namespace istio-system || true

# ==============================
# Install asmcli
# ==============================

curl -fL \
  https://storage.googleapis.com/csm-artifacts/asm/asmcli_1.28 \
  -o asmcli

chmod +x asmcli

gcloud services enable mesh.googleapis.com

# ==============================
# Validate Cloud Service Mesh
# ==============================

mkdir -p ./asm_output

./asmcli validate \
  --project_id "$PROJECT_ID" \
  --cluster_name "$CLUSTER_NAME" \
  --cluster_location "$CLUSTER_ZONE" \
  --fleet_id "$PROJECT_ID" \
  --output_dir ./asm_output || true

# ==============================
# Install Cloud Service Mesh
# ==============================

./asmcli install \
  --project_id "$PROJECT_ID" \
  --cluster_name "$CLUSTER_NAME" \
  --cluster_location "$CLUSTER_ZONE" \
  --fleet_id "$PROJECT_ID" \
  --output_dir ./asm_output \
  --enable_all \
  --option legacy-default-ingressgateway \
  --ca mesh_ca \
  --enable_gcp_components

# ==============================
# Configure Ingress Gateway
# ==============================

export GATEWAY_NS="istio-gateway"

kubectl create namespace "$GATEWAY_NS" || true

export REVISION=$(kubectl get deploy \
  -n istio-system \
  -l app=istiod \
  -o jsonpath='{.items[0].metadata.labels.istio\.io/rev}')

kubectl label namespace "$GATEWAY_NS" \
  istio.io/rev="$REVISION" \
  --overwrite

kubectl label namespace default \
  istio.io/rev="$REVISION" \
  --overwrite

kubectl label namespace default \
  istio-injection- || true

kubectl label namespace "$GATEWAY_NS" \
  istio-injection- || true

cd ~/asm_output

kubectl apply \
  -n "$GATEWAY_NS" \
  -f samples/gateways/istio-ingressgateway

# ==============================
# Deploy Bookinfo
# ==============================

ISTIO_DIR=$(find ~/asm_output \
  -maxdepth 1 \
  -type d \
  -name 'istio-*' \
  | sort | tail -n 1)

cd "$ISTIO_DIR"

kubectl apply \
  -f samples/bookinfo/platform/kube/bookinfo.yaml

# ==============================
# Verification
# ==============================

echo "======================================"
echo "Cloud Service Mesh installation done"
echo "======================================"

kubectl get nodes
kubectl get pods -n istio-system
kubectl get pods
kubectl get svc
kubectl get svc -n "$GATEWAY_NS"
