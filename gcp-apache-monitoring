#!/bin/bash
set -e
echo "==> Task 3: Configure Ops Agent"
sudo cp /etc/google-cloud-ops-agent/config.yaml /etc/google-cloud-ops-agent/config.yaml.bak
 
printf 'metrics:\n  receivers:\n    apache:\n      type: apache\n  service:\n    pipelines:\n      apache:\n        receivers:\n          - apache\nlogging:\n  receivers:\n    apache_access:\n      type: apache_access\n    apache_error:\n      type: apache_error\n  service:\n    pipelines:\n      apache:\n        receivers:\n          - apache_access\n          - apache_error\n' | sudo tee /etc/google-cloud-ops-agent/config.yaml > /dev/null
 
sudo service google-cloud-ops-agent restart
echo "==> Waiting 60s..."
sleep 60
echo "==> Done."
