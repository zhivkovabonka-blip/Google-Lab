main.tf
terraform {
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
  }
}

provider "google" {
  project = "qwiklabs-gcp-01-8afe4f29996d"
  region  = "europe-west4"
  zone    = "europe-west4-a"
}

module "vpc" {
  source  = "terraform-google-modules/network/google"
  version = "10.0.0"

  project_id   = "qwiklabs-gcp-01-8afe4f29996d"
  network_name = "tf-vpc-468277"
  routing_mode = "GLOBAL"

  subnets = [
    {
      subnet_name   = "subnet-01"
      subnet_ip     = "10.10.10.0/24"
      subnet_region = "europe-west4"
    },
    {
      subnet_name   = "subnet-02"
      subnet_ip     = "10.10.20.0/24"
      subnet_region = "europe-west4"
    }
  ]
}

resource "google_compute_firewall" "tf-firewall" {
  name    = "tf-firewall"
  network = "tf-vpc-468277"

  allow {
    protocol = "tcp"
    ports    = ["80"]
  }

  source_ranges = ["0.0.0.0/0"]
}

module "storage" {
  source = "./modules/storage"
}

module "instances" {
  source = "./modules/instances"
modules/storage/storage.tf
resource "google_storage_bucket" "storage-bucket" {
  name                        = "tf-bucket-168044"
  location                    = "EU"
  force_destroy               = true
  uniform_bucket_level_access = true
}

modules/instances/instances.tf
resource "google_compute_instance" "tf-instance-1" {
  name         = "tf-instance-1"
  machine_type = "e2-standard-2"
  zone         = "europe-west4-a"
  boot_disk {
    initialize_params { image = "debian-cloud/debian-11" }
  }
  network_interface {
    network    = "tf-vpc-468277"
    subnetwork = "subnet-01"
    access_config {}
  }
  allow_stopping_for_update = true
}

resource "google_compute_instance" "tf-instance-2" {
  name         = "tf-instance-2"
  machine_type = "e2-standard-2"
  zone         = "europe-west4-a"
  boot_disk {
    initialize_params { image = "debian-cloud/debian-11" }
  }
  network_interface {
    network    = "tf-vpc-468277"
    subnetwork = "subnet-02"
    access_config {}
  }
  allow_stopping_for_update = true
}
