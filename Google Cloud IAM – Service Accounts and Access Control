# Google Cloud IAM & Service Accounts Lab
# Project: qwiklabs-gcp-04-fe74a77ce0b5
# Region: us-west3
# Zone: us-west3-c

# Set project
gcloud config set project qwiklabs-gcp-04-fe74a77ce0b5

# Remove Project Viewer from Username 2
gcloud projects remove-iam-policy-binding qwiklabs-gcp-04-fe74a77ce0b5 \
  --member="user:student-01-64c676873fae@qwiklabs.net" \
  --role="roles/viewer"

# Grant Storage Object Viewer to Username 2
gcloud projects add-iam-policy-binding qwiklabs-gcp-04-fe74a77ce0b5 \
  --member="user:student-01-64c676873fae@qwiklabs.net" \
  --role="roles/storage.objectViewer"

# Create Service Account
gcloud iam service-accounts create read-bucket-objects \
  --display-name="read-bucket-objects"

# Grant Storage Object Viewer to Service Account
gcloud projects add-iam-policy-binding qwiklabs-gcp-04-fe74a77ce0b5 \
  --member="serviceAccount:read-bucket-objects@qwiklabs-gcp-04-fe74a77ce0b5.iam.gserviceaccount.com" \
  --role="roles/storage.objectViewer"

# Grant Service Account User to Altostrat
gcloud iam service-accounts add-iam-policy-binding \
  read-bucket-objects@qwiklabs-gcp-04-fe74a77ce0b5.iam.gserviceaccount.com \
  --member="domain:altostrat.com" \
  --role="roles/iam.serviceAccountUser"

# Grant Compute Instance Admin (v1) to Altostrat
gcloud projects add-iam-policy-binding qwiklabs-gcp-04-fe74a77ce0b5 \
  --member="domain:altostrat.com" \
  --role="roles/compute.instanceAdmin.v1"

# Create VM with Debian 12 and Storage Read/Write access
gcloud compute instances create demoiam \
  --project=qwiklabs-gcp-04-fe74a77ce0b5 \
  --zone=us-west3-c \
  --machine-type=e2-micro \
  --image-family=debian-12 \
  --image-project=debian-cloud \
  --service-account=read-bucket-objects@qwiklabs-gcp-04-fe74a77ce0b5.iam.gserviceaccount.com \
  --scopes=storage-rw

# Verify VM configuration
gcloud compute instances describe demoiam \
  --zone=us-west3-c \
  --format="yaml(name,serviceAccounts)"

# Verify IAM policy
gcloud projects get-iam-policy qwiklabs-gcp-04-fe74a77ce0b5 \
  --flatten="bindings[].members" \
  --format="table(bindings.role,bindings.members)"
